# ===================================
# إعدادات السيرفر - HalManhaj
# ===================================

# المنفذ (Port)
PORT=5000

# رابط قاعدة البيانات PostgreSQL
# صيغة: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://username:password@localhost:5432/halmanhaj

# مفتاح JWT السري (استخدم مفتاح طويل وعشوائي في الإنتاج)
# يمكنك توليد واحد بالأمر: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this

# بيئة التشغيل (development | production)
NODE_ENV=production
